{
  "expo": {
    "name": "Vacinas do Pet",
    "slug": "petvaccines",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petvaccines",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.simplifica.petvaccines"
    },
    "android": {
      "package": "com.simplifica.petvaccines",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2E1065",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E1065",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#5B4BC4",
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "A câmera é usada só para fotografar o comprovante de vacinação e a foto do pet. As fotos ficam guardadas no seu aparelho.",
          "photosPermission": "As fotos da galeria são usadas só para anexar o comprovante de vacinação e a foto do pet. Elas ficam guardadas no seu aparelho.",
          "microphonePermission": false
        }
      ],
      "react-native-zip-archive"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9385426c-d89c-4bf1-98ec-e1e618aa3a4f"
      }
    }
  }
}
